# Porta unica di sviluppo
PORT=3000
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# OpenRouter (LLM — DeepSeek V4 Flash)
OPENROUTER_API_KEY=your_openrouter_key_here
# Alias accettato dal server (legacy): DEEPSEEK_API_KEY=
# Modello predefinito (consigliato: deepseek/deepseek-chat — il tier :free è spesso saturo)
OPENROUTER_MODEL=deepseek/deepseek-chat
# Opzionale: modello per trascrizione audio (default google/gemini-2.5-flash via OpenRouter)
# OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# Supabase — API Keys: solo la chiave publishable (sb_publishable_...) o anon (eyJ...)
# Project URL: NON è sempre visibile in API Keys. Usa una di queste opzioni:
#
# Opzione A — Reference ID da Settings → General (consigliata)
#   Dashboard → ingranaggio Settings → General → copia "Reference ID"
VITE_SUPABASE_PROJECT_REF=your_reference_id_here
#
# Opzione B — URL completo (se lo vedi in Connect o Settings → API legacy)
# VITE_SUPABASE_URL=https://your_reference_id.supabase.co

VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Supabase service role — SOLO server (sync ANAC). Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Sync ANAC (Fase 2) ---
# Test immediato: catalogo demo ampliato (10 gare extra)
ANAC_SYNC_USE_DEMO_EXPAND=true
ANAC_SYNC_LIMIT=200
# Produzione: URL JSON da portale dati.anticorruzione.it (risorsa dataset)
# ANAC_SYNC_JSON_URL=https://example.com/bandi.json
# Oppure CKAN package id
# ANAC_CKAN_PACKAGE_ID=pubblicazioni
# Sync automatico ogni N minuti (0 = disabilitato)
# ANAC_SYNC_INTERVAL_MINUTES=360
# Protezione endpoint sync (opzionale)
# ANAC_SYNC_SECRET=your_cron_secret
