# Porta unica di sviluppo
PORT=3000
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Gemini (server-side)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase — API Keys: solo la chiave publishable (sb_publishable_...) o anon (eyJ...)
# Project URL: NON è sempre visibile in API Keys. Usa una di queste opzioni:
#
# Opzione A — Reference ID da Settings → General (consigliata)
#   Dashboard → ingranaggio Settings → General → copia "Reference ID"
VITE_SUPABASE_PROJECT_REF=your_reference_id_here
#
# Opzione B — URL completo (se lo vedi in Connect o Settings → API legacy)
# VITE_SUPABASE_URL=https://your_reference_id.supabase.co

VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
